#!/usr/bin/env bash
# ES Modules の import / export 整合を機械的に検査する。
#
#   使い方（リポジトリのルートで）:  bash tools/check-modules
#   未解決の import が1件でもあれば終了コード 1。
#
# なぜ必要か：import 名の綴り違いや export 漏れは、ブラウザで
# 「モジュール全体が読めない」＝テストが0件実行という形で失敗する。
# 目視の突き合わせでは複数行の import 文を取りこぼすため、
# 行連結してから集合差を取る。
set -u
# リポジトリのルートへ。source 実行でも壊れないよう git に聞く（無ければ現在地）。
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$ROOT" || return 2 2>/dev/null || exit 2

# 対象ファイルが見つからないまま「OK」と出すと偽の合格になるので必ず落とす。
count_js=$(ls -1 js/*.js 2>/dev/null | wc -l)
if [ "$count_js" -eq 0 ]; then
  echo "ERROR: js/*.js が見つかりません（$ROOT で実行してください）"
  return 2 2>/dev/null || exit 2
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# 1) 各モジュールの export 名（"module.js NAME" の形）
: > "$TMP/exports.txt"
for f in js/*.js; do
  b=$(basename "$f")
  grep -oE "^export (function|const|let|class) [A-Za-z0-9_]+" "$f" \
    | sed -E "s/^export (function|const|let|class) //" \
    | sed "s|^|$b |" >> "$TMP/exports.txt"
done

# 2) 全 import 文（複数行を行連結して1件として抽出）
: > "$TMP/imports.txt"
for f in js/*.js tests.html; do
  [ -f "$f" ] || continue
  b=$(basename "$f")
  tr '\n' ' ' < "$f" | grep -oE "import \{[^}]*\} from '[^']+'" | while read -r st; do
    mod=$(printf '%s' "$st" | sed -E "s|.*from '||; s|'.*||")
    mod=$(basename "$mod")
    printf '%s' "$st" | sed -E "s|import \{||; s|\}.*||" | tr ',' '\n' \
      | sed -E "s/ as .*//; s/[[:space:]]//g" | grep -v '^$' \
      | sed "s|^|$b $mod |" >> "$TMP/imports.txt"
  done
done

# 3) 集合差その1：解決できない import（import した名前が export に無い）
fail=0
while read -r consumer mod name; do
  if ! grep -qx "$mod $name" "$TMP/exports.txt"; then
    echo "MISSING: $consumer が $mod の $name を import しているが export が無い"
    fail=1
  fi
done < "$TMP/imports.txt"

# 4) 集合差その2：**使っているのに import していない**名前
#    これを見ないと「migrate is not defined」のような実行時エラーを取り逃す。
#    ブラウザでは import 解決の失敗＝モジュール全体が読めない＝テストが1件も走らないため、
#    「緑でも赤でもない」最悪の状態になる。ここで機械的に落とす。
#    走査対象は自プロジェクトの export 名だけ（外部語彙を相手にしないので誤検出が少ない）。
cut -d' ' -f2 "$TMP/exports.txt" | sort -u > "$TMP/all-exports.txt"
for f in js/*.js tests.html; do
  [ -f "$f" ] || continue
  b=$(basename "$f")
  # 行コメントと JSDoc の継続行を落とす（コメント内の言及で誤検出しないため）
  sed -E 's://.*::; s:^[[:space:]]*\*.*::' "$f" > "$TMP/src.txt"
  # このファイルが import した名前／自前で宣言した名前／名前空間の別名は対象外
  awk -v b="$b" '$1==b {print $3}' "$TMP/imports.txt" | sort -u > "$TMP/have-names.txt"
  grep -oE "^[[:space:]]*(export )?(function|const|let|var|class) [A-Za-z0-9_]+" "$f" \
    | sed -E 's/.*(function|const|let|var|class) //' | sort -u >> "$TMP/have-names.txt"
  grep -oE "import \* as [A-Za-z0-9_]+" "$f" | sed -E 's/import \* as //' >> "$TMP/have-names.txt"
  sort -u "$TMP/have-names.txt" -o "$TMP/have-names.txt"
  while read -r name; do
    grep -qx "$name" "$TMP/have-names.txt" && continue
    # 呼び出し `name(` か、メンバー参照 `name.` のどちらか。直前がドットや語なら別物なので除く
    if grep -qE "(^|[^.[:alnum:]_])$name[[:space:]]*[(.]" "$TMP/src.txt"; then
      echo "NOT IMPORTED: $b が $name を使っているが import していない"
      fail=1
    fi
  done < "$TMP/all-exports.txt"
done

n_imp=$(wc -l < "$TMP/imports.txt")
n_exp=$(wc -l < "$TMP/exports.txt")
# import を1件も拾えていないのは抽出失敗。これも偽の合格なので落とす。
if [ "$n_imp" -eq 0 ] || [ "$n_exp" -eq 0 ]; then
  echo "ERROR: import/export を抽出できませんでした（import $n_imp / export $n_exp）"
  return 2 2>/dev/null || exit 2
fi
if [ "$fail" -eq 0 ]; then
  echo "OK: import $n_imp 件がすべて解決、使用名の import 漏れもゼロ"
  echo "    （export $n_exp 件 / 対象 $count_js モジュール ＋ tests.html）"
else
  echo "NG: 上記の問題があります（export $n_exp 件）"
fi

# 名前空間 import は名前照合できないので参考表示（このツールが保証しない範囲）
ns=$(grep -rhoE "import \* as [A-Za-z0-9_]+ from '[^']+'" js/ tests.html 2>/dev/null | sort -u)
[ -n "$ns" ] && {
  echo "--- 検査対象外：名前空間 import のメンバー名 ---"
  echo "$ns" | sed 's/^/  /'
  echo "  storage.svae() のような綴り誤りは検出できない（MAINTENANCE.md §11）"
}

exit "$fail"
